<link rel="stylesheet" href="{{ '/css/styles.css?v=1.1' | url }}">

<style>
  /* --- SMOOTH GRID ANIMATION CODES --- */

  /* Base state for all cards inside your grid layout */
  .post-card {
    opacity: 1;
    transform: scale(1);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease !important;
    visibility: visible;
  }

  /* The state when a card is filtered out by search or a checkbox */
 .post-card.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none; /* User can't click it */
    transform: scale(0);  /* Shrinks to nothing */
    height: 0;            /* Shrinks height so it doesn't push */
    margin: 0;            /* Removes padding */
    padding: 0;
    position: relative;
}

  /* Eliminate the sidebar structure and allow full screen spread */
  .archive-layout {
    display: block !important;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 20px;
    box-sizing: border-box;
    
  }

  /* FORCE A BEAUTIFUL 5-COLUMN GRID */
  .archive-layout .imageboard-grid {
    display: grid !important;
    grid-template-columns: repeat(5, 1fr) !important;
    gap: 20px !important;
  }

  /* Responsive fallback steps */
  @media (max-width: 1400px) {
    .archive-layout .imageboard-grid {
      grid-template-columns: repeat(4, 1fr) !important;
    }
  }

  @media (max-width: 1100px) {
    .archive-layout .imageboard-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }

  @media (max-width: 750px) {
    .archive-layout .imageboard-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (max-width: 600px) {
    .archive-layout .imageboard-grid {
      grid-template-columns: 1fr !important;
      gap: 15px !important;
      padding: 0px;
    }

    /* Optional: Ensure individual cards don't have side margins on mobile */
    .post-card {
      margin: 5px 0 !important;
    }

    .filter-panel-grid {
      grid-template-columns: 110px minmax(0, 1fr) !important;
    }
    .filter-category-btn {
      font-size: 0.8rem !important;
      padding: 8px !important;
    }
    .filter-tag-panel {
      max-height: 280px !important;
    }
    .filter-tag-group .filter-list {
      grid-template-columns: 1fr !important;
    }
  }

</style>
<div class="archive-layout">
  <header style="margin-bottom: 40px; text-align: center;">
    <h1>Support the Archive</h1>
    <p style="max-width: 600px; margin: 0 auto;">
      Every purchase here directly supports the maintenance of this database 
      and the production of abolitionist outreach content. 
      Wear your values and help spread the message.
    </p>
  </header>

  <!-- Your existing iframe -->
  <iframe src="https://arseniforfreedom.dashery.com/embed/v1/carousel?wmode=opaque" 
          width="100%" 
          height="600px" 
          style="border:none;">
  </iframe>
</div>