}

/* Ensure the wrapper doesn't force the dropdown to jump */
.search-wrapper {
  display: flex;
  align-items: center;
  max-width: 400px; /* Adjust as needed */
}

.custom-select {
  padding: 10px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
