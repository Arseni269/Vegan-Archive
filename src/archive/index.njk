  appearance: auto; /* Ensures the arrow shows up properly */
}

.custom-select:hover {
  border-color: #cbd5e1;
}

/* Ensure both states take up the exact same amount of space */
.tag {
    box-sizing: border-box; /* Crucial for keeping size stable */
    /* Give the unselected tag a transparent border of the same width as the selected one */
    border: 2px solid transparent; 
    transition: none; /* Turn off transitions while testing to see if the jump stops */
}

.tag.selected {
    /* Only change the color, NEVER the border width */
    border: 2px solid #000; 
    font-weight: bold; /* If this causes jumping, see step 2 below */
}
.tag-filter-container {
    /* Set a minimum height so it never collapses or expands unexpectedly */
    min-height: 50px; 
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}
.filter-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start; /* Ensures they stay aligned to the top */
    height: auto; /* Allow growth, but don't force it */
}
.filter-container {
    display: flex;
    flex-wrap: wrap;
    min-height: 80px; /* Force the container to always be this height */
    align-items: center; /* Keeps everything vertically aligned */
}
.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    filter: grayscale(1);
}
</style>
<script>
document.addEventListener("DOMContentLoaded", () => {
    // 1. Elements
    const sortDropdown = document.getElementById('sort-order');
    const checkboxes = document.querySelectorAll(".filter-checkbox");
    const postCards = document.querySelectorAll(".post-card");
    const clearFilterBtn = document.getElementById("clear-filters-btn");
    const clearSearchBtn = document.getElementById("clear-search-btn");
    const searchInput = document.getElementById("archive-search-input");
    const archiveGrid = document.getElementById("archive-grid");
    const noResultsMsg = document.getElementById("no-results-message");
    const searchContainer = document.getElementById("search-suggestions-container");
    const slugify = text => text ? text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : '';

    // --- PERSISTENCE FUNCTIONS ---
    function saveFilters() {
        const activeFilters = { creator: [], topic: [], language: [], misinformer: [] };
        checkboxes.forEach(box => { if (box.checked) activeFilters[box.name].push(box.value); });
        sessionStorage.setItem('archiveFilters', JSON.stringify(activeFilters));
    }

    function restoreFilters() {
        const urlParams = new URLSearchParams(window.location.search);

        // Case 1: URL has parameters (highest priority — this is what makes shared links work)
        if (urlParams.toString()) {
            checkboxes.forEach(box => {
                if (urlParams.getAll(box.name).includes(box.value)) {
                    box.checked = true;
                }
            });
            return;
        }

        // Case 2: No URL params, fall back to whatever was last selected this session
        const saved = sessionStorage.getItem('archiveFilters');
        if (!saved) return;
        const activeFilters = JSON.parse(saved);
        checkboxes.forEach(box => {
            if (activeFilters[box.name] && activeFilters[box.name].includes(box.value)) {
                box.checked = true;
            }
        });
    }

    // --- SORT FUNCTION ---
    function triggerSort(order) {
        const grid = document.getElementById('archive-grid');
        const posts = Array.from(grid.querySelectorAll('.post-card'));
        posts.sort((a, b) => {
            const dateA = parseInt(a.getAttribute('data-date') || 0);
            const dateB = parseInt(b.getAttribute('data-date') || 0);
            return order === 'newest' ? dateB - dateA : dateA - dateB;
        });
        posts.forEach(post => grid.appendChild(post));
    }

    // --- FILTER LOGIC ---
    function filterPosts(isInitial = false) {
        const searchQuery = searchInput ? searchInput.value.toLowerCase().trim() : "";
        const activeFilters = { creator: [], topic: [], language: [], misinformer: [] };
        checkboxes.forEach(box => { if (box.checked) activeFilters[box.name].push(box.value); });

        const dynamicCounts = {};
        checkboxes.forEach(input => dynamicCounts[input.value.trim()] = 0);

        let visibleCount = 0;
        postCards.forEach(card => {
            const creator = card.getAttribute('data-creator');
            const tagsAttr = card.getAttribute('data-tags') || "";
            const tags = tagsAttr.split(',').map(t => t.trim());
            const misinformerAttr = card.getAttribute('data-misinformer') || "";
            const misinformers = misinformerAttr.split(',').map(m => m.trim()).filter(Boolean);
            const textContent = card.getAttribute('data-search') || "";

            const matchSearch = textContent.includes(searchQuery);
            const matchCreator = activeFilters.creator.length === 0 || activeFilters.creator.every(c => c === creator);
            const matchMisinformer = activeFilters.misinformer.length === 0 || activeFilters.misinformer.every(c => misinformers.includes(c));
            const matchTopics = activeFilters.topic.length === 0 || activeFilters.topic.every(t => tags.includes(t));
            const matchLang = activeFilters.language.length === 0 || activeFilters.language.every(l => tags.includes(l));

            const isMatch = matchSearch && matchCreator && matchMisinformer && matchTopics && matchLang;

            if (isMatch) {
                card.style.display = "";
                visibleCount++;
                const attributes = [creator, ...tags, ...misinformers].filter(Boolean);
                attributes.forEach(val => { if (dynamicCounts.hasOwnProperty(val)) dynamicCounts[val]++; });
            } else {
                card.style.display = "none";
            }
        });

        if (noResultsMsg) noResultsMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
        checkboxes.forEach(box => {
            const count = dynamicCounts[box.value.trim()] || 0;
            const isDisabled = count === 0 && !box.checked;
            box.disabled = isDisabled;
            if (box.parentElement) box.parentElement.classList.toggle("is-disabled", isDisabled);
        });

        if (typeof updateActiveFiltersDisplay === 'function') updateActiveFiltersDisplay();
        updateFilterCounts(dynamicCounts);
    }

    // --- UI HELPERS ---
    function updateActiveFiltersDisplay() {
        const container = document.getElementById("active-filters-container");
        const tagsList = document.getElementById("tags-list");
        const checked = document.querySelectorAll(".filter-checkbox:checked");
        const badge = document.getElementById("active-filter-badge");
        if (badge) {
            badge.textContent = checked.length;
            badge.style.display = checked.length > 0 ? "inline-block" : "none";
        }
        if (!tagsList) return;
        tagsList.innerHTML = "";
        if (checked.length > 0) {
            container.style.display = "flex";
            checked.forEach(box => {
                const tag = document.createElement("span");
                tag.innerHTML = `${box.nextElementSibling.innerText} <span style="cursor:pointer; margin-left:8px;">&times;</span>`;
                tag.style = "background: #e2e8f0; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; display: flex; align-items: center;";
                tag.onclick = () => { box.checked = false; saveFilters(); filterPosts(); updateURL(); };
                tagsList.appendChild(tag);
            });
        } else { container.style.display = "none"; }
    }

    function updateFilterCounts(counts) {
        document.querySelectorAll('.filter-count').forEach(span => {
            const target = span.getAttribute('data-count-target');
            if (target in counts) {
                span.textContent = `(${counts[target]})`;
                span.closest('label').style.opacity = (counts[target] === 0) ? "0.3" : "1";
            }
        });
    }

    // --- LISTENERS ---
    if (sortDropdown) {
        sortDropdown.value = 'newest';
        triggerSort(sortDropdown.value);
        sortDropdown.addEventListener('change', (e) => triggerSort(e.target.value));
    }

    if (searchInput) {
        searchInput.addEventListener("input", () => {
            clearTimeout(window.typingTimeout);
            window.typingTimeout = setTimeout(filterPosts, 250);
        });
    }

    if (clearSearchBtn) {
        clearSearchBtn.addEventListener("click", () => {
            searchInput.value = "";
            filterPosts();
            searchContainer.classList.add("search-suggestions-hidden");
        });
    }

    checkboxes.forEach(box => box.addEventListener("change", () => {
        saveFilters();
        filterPosts();
        updateURL();
    }));
function updateURL() {
    const params = new URLSearchParams();
    
    // Collect all checked values
    checkboxes.forEach(box => {
        if (box.checked) {
            params.append(box.name, box.value);
        }
    });

    // Update the URL without reloading
    const newRelativePathQuery = window.location.pathname + '?' + params.toString();
    history.replaceState(null, '', newRelativePathQuery);
}
    if (clearFilterBtn) clearFilterBtn.addEventListener("click", () => { 
        checkboxes.forEach(b => b.checked = false); 
        sessionStorage.removeItem('archiveFilters');
        filterPosts(); 
        updateURL();
    });
// Use a more robust selector that finds the button anywhere on the page
const backToTopBtn = document.getElementById("back-to-top");

window.addEventListener("scroll", () => {
  if (window.scrollY > 300) {
    backToTopBtn.classList.add("is-visible");
  } else {
    backToTopBtn.classList.remove("is-visible");
  }
});

backToTopBtn.addEventListener("click", () => {
  window.scrollTo({
    top: 0,
    behavior: "smooth"
  });
});
    // --- FILTER BAR: open/close + category switching ---
    const filterBarToggle = document.getElementById("filter-bar-toggle");
    const filterPanel = document.getElementById("filter-panel");
    const categoryBtns = document.querySelectorAll(".filter-category-btn");
    const tagGroups = document.querySelectorAll(".filter-tag-group");
    const supportsHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    function setActiveCategory(category) {
        categoryBtns.forEach(btn => {
            const isActive = btn.dataset.category === category;
            btn.classList.toggle("is-active", isActive);
            btn.setAttribute("aria-selected", String(isActive));
        });
        tagGroups.forEach(group => {
            group.hidden = group.dataset.categoryPanel !== category;
        });
    }

    categoryBtns.forEach(btn => {
        btn.addEventListener("click", () => setActiveCategory(btn.dataset.category));
        if (supportsHover) {
            btn.addEventListener("mouseenter", () => setActiveCategory(btn.dataset.category));
        }
    });

    if (filterBarToggle && filterPanel) {
        filterBarToggle.addEventListener("click", () => {
            const isOpen = !filterPanel.hidden;
            filterPanel.hidden = isOpen;
            filterBarToggle.setAttribute("aria-expanded", String(!isOpen));
            filterBarToggle.classList.toggle("is-open", !isOpen);
        });

        // Click anywhere outside the filter bar closes the panel
        document.addEventListener("click", (e) => {
            if (!filterPanel.hidden && !e.target.closest(".filter-bar")) {
                filterPanel.hidden = true;
                filterBarToggle.setAttribute("aria-expanded", "false");
                filterBarToggle.classList.remove("is-open");
            }
        });
    }

    // --- NEXT/PREV NAVIGATION CONTEXT ---
    // Right before the user actually navigates into a post, snapshot the
    // ordered list of URLs currently visible in the grid (i.e. respecting
    // whatever filters/search are active) so post.njk can offer next/prev
    // links that move through that same filtered set instead of the full
    // unfiltered archive.
    const archiveGridEl = document.getElementById("archive-grid");
    if (archiveGridEl) {
        archiveGridEl.addEventListener("click", (e) => {
            const link = e.target.closest("a");
            if (!link) return;
            const card = link.closest(".post-card");
            if (!card) return;

            const visibleUrls = Array.from(document.querySelectorAll(".post-card"))
                .filter(c => !c.classList.contains("is-hidden") && c.style.display !== "none")
                .map(c => {
                    const a = c.querySelector(".post-title a");
                    return a ? a.getAttribute("href") : null;
                })
                .filter(Boolean);

            const payload = {
                urls: visibleUrls,
                savedAt: Date.now()
            };
            localStorage.setItem("archiveNavContext", JSON.stringify(payload));
        });
    }

    // --- INITIALIZATION ---
    restoreFilters(); // Restore state first
    filterPosts(true); // Then run the first filter
});
</script>