---
layout: base.njk
templateEngineOverride: njk
pagination:
  data: collections.letterAuthors
  size: 1
  alias: authorData
permalink: "/letters/{{ authorData.slug }}/"
eleventyComputed:
  title: "{{ authorData.name }} — Founding Letters"
---
<style>
  .author-letters-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .author-letters-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .author-letters-back:hover {
    color: var(--accent);
  }

  .author-letters-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1.5rem 0;
  }

  .letter-card {
    display: block;
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    margin-bottom: 0.75rem;
  }
  .letter-card:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }

  .letter-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.25rem 0;
  }

  .letter-card-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>

<div class="author-letters-wrapper">
  <a href="/letters/" class="author-letters-back">← All Authors</a>
  <h1 class="author-letters-title">{{ authorData.name }}</h1>

  {% for letter in authorData.letters %}
  <a href="{{ letter.url }}" class="letter-card">
    <p class="letter-card-title">{{ letter.title }}</p>
    <p class="letter-card-meta">{% if letter.writtenAt %}{{ letter.writtenAt }}{% endif %}{% if letter.writtenAt and letter.writtenDate %}, {% endif %}{% if letter.writtenDate %}{{ letter.writtenDate }}{% endif %}</p>
  </a>
  {% endfor %}
</div>
